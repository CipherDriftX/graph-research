# Copy to .env and fill in your own values. .env is gitignored.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=niche_harness
POSTGRES_USER=niche_harness
POSTGRES_PASSWORD=change_me
# prefer works for a local server. Use require for a managed database.
POSTGRES_SSLMODE=prefer

# YouTube Data API v3. Needed in live mode, and for --snapshot.
YOUTUBE_API_KEY=
# live calls the API. replay serves fixtures/youtube and needs no key.
YOUTUBE_MODE=live

# Bright Data YouTube collectors. Needed for discovery in live mode.
BRIGHTDATA_API_KEY=
# live calls Bright Data. replay serves fixtures/brightdata and spends nothing.
BRIGHTDATA_MODE=live
# The collector IDs default to the public YouTube datasets in src/config.py.
# BRIGHTDATA_CHANNELS_DATASET_ID=gd_lk538t2k2p1k3oos71
# BRIGHTDATA_VIDEOS_DATASET_ID=gd_lk56epmy2i5g7lzu0k
# BRIGHTDATA_COMMENTS_DATASET_ID=gd_lk9q0ew71spt1mxywf

# OpenRouter serves both model families (DeepSeek V4, Kimi K3).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Run size. Each profile sets every cost ceiling; see PROFILES in src/config.py.
#   smoke    150 records, $1 of LLM spend, comment mining off
#   bounded  1,500 records, $5 of LLM spend
#   full     no record or round caps, $10 of LLM spend
HARNESS_PROFILE=smoke
SATURATION_NOVELTY_THRESHOLD=0.05
SATURATION_CONSECUTIVE_WINDOW=3
LOG_LEVEL=INFO

# Single ceilings. These override the profile for every run, so prefer
# changing HARNESS_PROFILE.
# BUDGET_LIMIT_USD=1.00
# BRIGHTDATA_RECORD_BUDGET=150
# GRAPH_WALK_FRONTIER_PER_ROUND=5
# MAX_ROUNDS_PER_BRANCH=4

# Branch splitting. Louvain runs on every saturated node.
# MIN_CHANNELS_FOR_SPLIT=8
# MIN_CLUSTER_DISTINCTNESS=0.3
# CLUSTER_SEED=42
# BRANCH_LINEAGE_BUDGET_ENABLED=true
